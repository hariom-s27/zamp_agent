# Streamlit Community Cloud: paste these lines into the app's Secrets box
# (App settings, Secrets). Locally, use .env instead; this file is only a template.
# Never commit a real secrets.toml.

# The hosted demo replays recorded answers: no key is needed for it.
LLM_MODE = "fixture"

# Every visitor gets their own sandbox, so nobody can reset or fill the books during your demo.
INVOICE_DESK_SANDBOX = "session"

# The samples are dated November 2026. Pinning the business date keeps the demo the same next year.
INVOICE_DESK_TODAY = "2026-11-21"

# Bundled scans use their recorded OCR output, so a different Tesseract build on the host cannot change a demo result.
OCR_MODE = "fixture"

# ---- Optional: let visitors switch on live AI, inside a small daily budget ----------
# Uncomment all four lines. The mode shown on screen can then be switched to cached-live.
# Also set a monthly spend limit for this key's workspace in the Claude Console: the cap
# below is kept in a file on the host, and a free host can lose that file on restart.
# ANTHROPIC_API_KEY = "sk-ant-..."
# LLM_ALLOW_LIVE = "1"
# LLM_DAILY_CAP_USD = "0.50"
# LLM_MAX_COST_PER_INVOICE_USD = "0.02"
