# Everything in this file is optional. The app runs with no .env at all.
# To use it: copy this file to .env and fill in what you need. Never commit .env.
# On Streamlit Community Cloud the same names go into the app's Secrets box
# (see .streamlit/secrets.toml.example).

# ---- AI assist (Claude) -----------------------------------------------------------
# Three modes. The default needs no key and makes no network call.
#   fixture      replay answers recorded earlier in fixtures/llm (the demo default)
#   cached-live  reuse a stored answer for the same file, prompt version and model;
#                otherwise call the Claude API once, inside the caps below, and store it
#   off          rules only
# A key on its own changes nothing: live calls happen only when LLM_MODE=cached-live.
# LLM_MODE=fixture

# Your key from https://platform.claude.com/ (Settings, API keys). Needed for cached-live
# mode and for scripts/record_llm_fixtures.py. It is read from here, sent only to the
# Claude API, and never written to a file or shown on screen.
ANTHROPIC_API_KEY=

# The fast, low-cost model is the default. A stronger one can be the main model, or be
# tried once when the first answer gives nothing usable.
# LLM_MODEL=claude-haiku-5-5
# LLM_ESCALATION_MODEL=claude-sonnet-5-5

# Bounds on a call and on spend (US dollars).
# LLM_TIMEOUT_S=20
# LLM_MAX_RETRIES=2
# LLM_MAX_OUTPUT_TOKENS=4096
# How much work the model puts into an answer: low, medium or high. Leave it unset to use the
# model's own default (medium on Claude Haiku 5.5, high on Claude Sonnet 5.5). Try high if quotes
# come back inexact and values are rejected.
# LLM_EFFORT=
# LLM_MAX_COST_PER_INVOICE_USD=0.05
# LLM_DAILY_CAP_USD=1.00
# Prices are built in for the current models (llm.py). If they change, set both:
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# ---- OCR --------------------------------------------------------------------------
# auto (default): Tesseract when it is installed, otherwise recorded output for the
#                 bundled scans
# live | fixture
# OCR_MODE=auto
# Only if tesseract.exe is not on PATH and not in the default install folder:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Demo -------------------------------------------------------------------------
# The business date. The samples are dated November 2026; pinning the date keeps date
# rules (invoice too old, dated in the future) from changing a rehearsed demo later on.
# The app pins this date by itself (the switch is on the Guided demo page). Set it here
# to pin the command line and the scripts as well.
# INVOICE_DESK_TODAY=2026-11-21

# shared (default): one database for everyone who opens the app, kept between restarts.
# session: every browser session gets its own sandbox. Use this on a public host, so a
#          visitor cannot reset or fill the books in the middle of your demo.
# INVOICE_DESK_SANDBOX=shared
# With session sandboxes (a public demo), a key alone does not put live AI on screen.
# This switch does, and the daily cap above still applies.
# LLM_ALLOW_LIVE=1

# Where the databases and stored uploads go (default: data/runtime inside the project).
# INVOICE_DESK_HOME=

# ---- Audit trail ------------------------------------------------------------------
# Optional. With a key here, every receipt is also signed (HMAC-SHA256). The key lives
# outside the database, so someone who can edit the database cannot rewrite history
# without it. Without a key the receipts are chained by hash only.
# RECEIPT_SIGNING_KEY=
