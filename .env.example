# Everything in this file is optional. The app runs with no .env at all.
# To use it: copy this file to .env and fill in what you need. Never commit .env.

# ---- LLM assist (optional) -------------------------------------------------------
# Any OpenAI-compatible chat endpoint. All three values must be set to turn it on.
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL is a model name from your provider's own list.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# auto (default): live when the three values above are set, otherwise replay recorded
#                 responses from fixtures/llm (and do nothing when there is none)
# live | replay | off
# LLM_MODE=auto
# LLM_TIMEOUT_S=25

# ---- OCR --------------------------------------------------------------------------
# auto (default): Tesseract when it is installed, otherwise recorded output for the
#                 bundled scans
# live | fixture
# OCR_MODE=auto
# Only if tesseract.exe is not on PATH and not in the default install folder:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Demo ---------------------------------------------------------------------------
# Freeze "today" so date rules give the same result whenever a recorded demo is replayed.
# INVOICE_DESK_TODAY=2026-11-21
# Where the SQLite file and stored uploads go (default: data/runtime inside the project).
# INVOICE_DESK_HOME=
